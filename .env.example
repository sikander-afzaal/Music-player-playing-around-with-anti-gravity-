# Spotify Developer App Client ID (https://developer.spotify.com/dashboard)
# Add http://127.0.0.1:3000 as a Redirect URI in your Spotify App settings
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=

# Google Cloud OAuth 2.0 Web Client ID (https://console.cloud.google.com/apis/credentials)
# Enable YouTube Data API v3 and add http://127.0.0.1:3000 to Authorized Origins & Redirect URIs
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
